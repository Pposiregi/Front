{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // IDE가 상위 RN tsconfig를 놓치는 경우를 대비한 중복 명시.
    // 런타임 기능과 무관, 에디터의 JSX/React import 인식 안정화 목적
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@hooks/*": ["hooks/*"],
      "@utils/*": ["utils/*"],
      "@slices/*": ["slices/*"],
      "@assets/*": ["assets/*"],
      "@styles/*": ["styles/*"],
      "@store/*": ["store/*"],
      "@api/*": ["api/*"],
      "@types/*": ["types/*"],
      "@shared/*": ["shared/*"],
      "@navigation/*": ["navigation/*"],
      "@native/*": ["native/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/images.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
