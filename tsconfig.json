{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@hooks/*": ["hooks/*"],
      "@utils/*": ["utils/*"],
      "@slices/*": ["slices/*"],
      "@assets/*": ["assets/*"],
      "@styles/*": ["styles/*"],
      "@store/*": ["store/*"],
      "@api/*": ["api/*"],
      "@types/*": ["types/*"],
      "@shared-types/*": ["shared/types/*"],
      "@navigation/": ["navigation/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/images.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
