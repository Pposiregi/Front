+fun ReadableArray.toMapList(): List<ReadableMap> {
+  val list = mutableListOf<ReadableMap>()
+  for (i in 0 until size()) {
+    val item = getMap(i)
+    if (null != item) {
+      list.add(item)
+    }
+  }
+  return list
+}
